# Copy to .env and fill in values (do not put real secrets here)
#
# Production (Vercel): Project → Settings → Environment Variables
#   XAI_API_KEY = (your key from console.x.ai)
#   XAI_MODEL   = grok-4.3
# Apply to Production + Preview, then Redeploy.

XAI_API_KEY=
XAI_MODEL=grok-4.3

# Optional fallbacks (only used if XAI_API_KEY is missing)
# DEEPSEEK_API_KEY=
# BUILT_IN_FORGE_API_KEY=
# BUILT_IN_FORGE_API_URL=
