# Flow Guru — Grok-first AI (xAI)
# Copy to .env for local. On Vercel: Settings → Environment Variables → Production + Preview → Redeploy.

# Required for chat
XAI_API_KEY=
XAI_MODEL=grok-4.3

# Optional: force provider (xai | deepseek | moonshot | forge | auto)
# LLM_PROVIDER=xai

# Optional: allow DeepSeek/Forge only if Grok is missing or as backups
# LLM_ALLOW_FALLBACKS=false

# Optional fallbacks (not used unless LLM_ALLOW_FALLBACKS=true or no XAI key)
# DEEPSEEK_API_KEY=
# BUILT_IN_FORGE_API_KEY=
# BUILT_IN_FORGE_API_URL=
